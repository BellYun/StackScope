{
  "name": "stackscope",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter @stackscope/frontend dev",
    "dev:backend": "pnpm --filter @stackscope/backend dev",
    "build": "pnpm -r build",
    "start:frontend": "pnpm --filter @stackscope/frontend start",
    "start:backend": "pnpm --filter @stackscope/backend start",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22"
  }
}
